SPRING_PROFILES_ACTIVE=prod

## DB (RDS 사용 시 엔드포인트, docker-compose MySQL 사용 시 서비스명 'flowfin')
DB_HOST=your-rds-endpoint
DB_PORT=3306
DB_NAME=flowfin
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=        # docker-compose MySQL 컨테이너 전용 (RDS 사용 시 불필요)

## Redis (ElastiCache 사용 시 엔드포인트, docker-compose Redis 사용 시 서비스명 'redis')
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

## JWT
JWT_SECRET=
JWT_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=86400000

## AES-256 암호화 (32자 이상 권장)
AES_SECRET_KEY=

## CODEF API
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=

## OpenAI
OPENAI_API_KEY=
OPENAI_MODEL_CLASSIFICATION=gpt-4.1-nano
OPENAI_MODEL_PORTFOLIO=gpt-4o

## Mail
MAIL_USERNAME=
MAIL_PASSWORD=

## JVM (t3.medium: MySQL + Redis + Spring 동시 운영 기준)
JAVA_TOOL_OPTIONS=-Xmx512m
